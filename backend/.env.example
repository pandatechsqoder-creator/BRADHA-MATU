APP_NAME="BRATHAMATU Stocktake"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173

# Google marketing integrations (owner-provided; leave blank to show the honest
# "not configured" state). Register the redirect URI in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/platform/marketing/integrations/google/callback
GOOGLE_OAUTH_SCOPES=openid,email,profile,https://www.googleapis.com/auth/webmasters.readonly,https://www.googleapis.com/auth/analytics.readonly,https://www.googleapis.com/auth/business.manage,https://www.googleapis.com/auth/tagmanager.readonly
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_ANALYTICS_PROPERTY_ID=

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://127.0.0.1:8000/api/v1/platform/marketing/integrations/meta/callback
META_GRAPH_VERSION=v21.0
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,read_insights,instagram_basic,instagram_content_publish,ads_read,business_management
META_AD_ACCOUNT_ID=
META_BUSINESS_ID=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local MySQL 8 (portable install at C:\tools\mysql8, port 3307).
# Interim fallback: XAMPP MariaDB on 3306 — see docs/adr/0001-technology-baseline.md.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_ENGINE=InnoDB
DB_DATABASE=panda_stocktake
DB_USERNAME=panda
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SANCTUM_TOKEN_EXPIRATION=1440

TENANT_BASE_DOMAIN=communitygroup.co.ke
DOMAIN_RESERVATION_MINUTES=30
TENANT_SLUG_MIN_LENGTH=2
TENANT_SLUG_MAX_LENGTH=63
TENANT_SLUG_SUGGESTION_NUMBER_LIMIT=10
REGISTRATION_VERIFICATION_MINUTES=15
REGISTRATION_VERIFICATION_MAX_ATTEMPTS=5
REGISTRATION_RESEND_COOLDOWN_SECONDS=60
REGISTRATION_MAX_RESENDS=5

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="noreply@brathamatu.local"
MAIL_FROM_NAME="${APP_NAME}"
PAYMENTS_SANDBOX=true
PAYMENTS_SANDBOX_SECRET=local-sandbox-signature
MPESA_SHORTCODE=174379
MPESA_PAYBILL=174379
MPESA_CALLBACK_URL="${APP_URL}/api/v1/payments/mpesa/callback"
CARD_GATEWAY=sandbox-card
BANK_NAME="BRATHAMATU Sandbox Bank"
BANK_ACCOUNT_NAME="BRATHAMATU Ltd"
BANK_ACCOUNT_NUMBER=0000000000
BANK_BRANCH=Nairobi

RETENTION_NOTIFICATIONS_DAYS=180
RETENTION_READ_NOTIFICATIONS_DAYS=90
RETENTION_WEBHOOK_EVENTS_DAYS=90
RETENTION_REPORT_RUNS_DAYS=365
RETENTION_CLOSED_TICKETS_DAYS=730
RETENTION_EXPIRED_TOKENS_DAYS=7
RETENTION_MARKETING_ANALYTICS_DAYS=400
RETENTION_MARKETING_CONVERSION_DAYS=730
RETENTION_MARKETING_TRACKING_DAYS=180
RETENTION_AUTOMATION_RUNS_DAYS=365

# Public website (marketing Phase 1). These values seed marketing_settings and
# can be changed without a deploy. Contact details stay hidden until confirmed.
MARKETING_BRAND_NAME="BRATHAMATU"
MARKETING_BRAND_STOCKTAKE="BRATHAMATU Stocktake"
MARKETING_BRAND_POS="BRATHAMATU POS"
MARKETING_CONTACT_EMAIL=
MARKETING_CONTACT_PHONE=
MARKETING_CONTACT_WHATSAPP=
MARKETING_CONTACT_ADDRESS=
# Scheme + host used for canonicals and sitemap URLs (defaults to APP_URL).
MARKETING_CANONICAL_BASE=
# Search indexing defaults to on only when APP_ENV=production.
# MARKETING_INDEXABLE=true
