# Production template for the BRATHAMATU Laravel API.
# Copy to .env on the server, fill every blank, then run:
#   php artisan key:generate --force
#   php artisan migrate --force
#   php artisan optimize
# Never commit the filled file. `php artisan health:check` fails when APP_DEBUG is
# true, APP_URL is not https, or SESSION_SECURE_COOKIE is false in production.

APP_NAME="BRATHAMATU Stocktake"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.example.com
FRONTEND_URL=https://www.example.com
LOG_LEVEL=warning

# Database (dedicated least-privilege user; no root).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_ENGINE=InnoDB
DB_DATABASE=brathamatu
DB_USERNAME=brathamatu_app
DB_PASSWORD=

# Sessions and cookies. Sanctum tokens expire per SANCTUM_TOKEN_EXPIRATION.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_TOKEN_EXPIRATION=1440

# Queue and cache (Redis or database; the health probe reads the configured queue).
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Public website indexing. Leave MARKETING_INDEXABLE unset in production (defaults
# to true); staging and preview environments must stay false.
# MARKETING_INDEXABLE=true

# Owner-confirmed public contact details (hidden while blank).
MARKETING_CONTACT_EMAIL=
MARKETING_CONTACT_PHONE=
MARKETING_CONTACT_WHATSAPP=
MARKETING_CONTACT_ADDRESS=

# Marketing integrations remain in honest "not configured" states while blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.example.com/api/v1/platform/marketing/integrations/google/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://www.example.com/api/v1/platform/marketing/integrations/meta/callback

# SMTP is required to deliver account verification codes.
TENANT_BASE_DOMAIN=communitygroup.co.ke
DOMAIN_RESERVATION_MINUTES=30

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=example.com
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="BRATHAMATU Stocktake"

# Marketing automation external steps stay blocked until their own providers
# are selected and configured.

# Privacy retention windows (days). Audit logs are never purged.
RETENTION_NOTIFICATIONS_DAYS=180
RETENTION_READ_NOTIFICATIONS_DAYS=90
RETENTION_WEBHOOK_EVENTS_DAYS=90
RETENTION_REPORT_RUNS_DAYS=365
RETENTION_CLOSED_TICKETS_DAYS=730
RETENTION_EXPIRED_TOKENS_DAYS=7
RETENTION_MARKETING_ANALYTICS_DAYS=400
RETENTION_MARKETING_CONVERSION_DAYS=730
RETENTION_MARKETING_TRACKING_DAYS=180
RETENTION_AUTOMATION_RUNS_DAYS=365
